# ==============================================================================
# ONLINE C SUITE - VEA CONFIGURATION
# ==============================================================================
# Copy this file to .env and fill in your actual values
# ==============================================================================

# ------------------------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------------------------
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://user:password@localhost:5432/online_csuite?schema=public"

# ------------------------------------------------------------------------------
# AUTHENTICATION (Clerk)
# ------------------------------------------------------------------------------
# Get these from https://dashboard.clerk.com
CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# JWT token secret for session verification
CLERK_JWT_VERIFICATION_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# ------------------------------------------------------------------------------
# API SERVER
# ------------------------------------------------------------------------------
# Server configuration
NODE_ENV="development"  # development | test | production
PORT="3001"
API_URL="http://localhost:3001"

# CORS allowed origins (comma-separated)
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# ------------------------------------------------------------------------------
# LLM PROVIDER (Fireworks AI)
# ------------------------------------------------------------------------------
# Get API key from https://fireworks.ai/api-keys
FIREWORKS_API_KEY="fw_..."

# Model selection
FIREWORKS_MODEL="accounts/fireworks/models/qwen2p5-72b-instruct"

# ------------------------------------------------------------------------------
# VEA (VIRTUAL EXECUTIVE ASSISTANT)
# ------------------------------------------------------------------------------
# Enable/disable VEA tool execution
VEA_ENABLED="true"

# Use mock orchestrator for development (true) or real VPA-Core (false)
VEA_USE_MOCK_ORCHESTRATOR="true"

# Require approval for high-risk actions
VEA_REQUIRE_APPROVAL="false"

# Risk score threshold (0-100) for requiring approval
VEA_RISK_THRESHOLD="75"

# ------------------------------------------------------------------------------
# VPA-CORE (MCP MODULES)
# ------------------------------------------------------------------------------
# Only needed if VEA_USE_MOCK_ORCHESTRATOR="false"

# ProspectFinder Configuration
PROSPECTFINDER_API_KEY=""
PROSPECTFINDER_API_URL="http://localhost:8001"

# LeadTracker Pro Configuration
LEADTRACKER_API_URL="http://localhost:8002"

# Email Orchestrator Configuration
EMAIL_SMTP_HOST="smtp.gmail.com"
EMAIL_SMTP_PORT="587"
EMAIL_SMTP_USER=""
EMAIL_SMTP_PASSWORD=""
EMAIL_FROM_ADDRESS=""

# Bookkeeping Assistant Configuration
BOOKKEEPING_API_URL="http://localhost:8003"

# Content Creator Configuration
CONTENT_OPENAI_API_KEY=""

# Social Media Manager Configuration
SOCIAL_LINKEDIN_API_KEY=""
SOCIAL_TWITTER_API_KEY=""

# Time Billing Agent Configuration
TIMEBILLING_API_URL="http://localhost:8004"

# ------------------------------------------------------------------------------
# RATE LIMITING
# ------------------------------------------------------------------------------
# Chat endpoint rate limits
CHAT_RATE_LIMIT_WINDOW_MS="60000"     # 1 minute
CHAT_RATE_LIMIT_MAX_REQUESTS="30"     # 30 requests per minute

# ------------------------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------------------------
# Log level: error | warn | info | debug
LOG_LEVEL="info"

# Enable detailed API logging
API_LOGGING_ENABLED="true"

# Enable SSE (Server-Sent Events) logging
SSE_LOGGING_ENABLED="true"

# ------------------------------------------------------------------------------
# FEATURE FLAGS
# ------------------------------------------------------------------------------
# Enable experimental features
ENABLE_BOARD_MEETINGS="false"
ENABLE_MULTI_PERSONA_CHAT="false"
ENABLE_ACTION_APPROVAL_UI="false"

# ------------------------------------------------------------------------------
# ANALYTICS
# ------------------------------------------------------------------------------
# PostHog (optional)
POSTHOG_API_KEY=""
POSTHOG_HOST="https://app.posthog.com"

# ------------------------------------------------------------------------------
# MONITORING (optional)
# ------------------------------------------------------------------------------
# Sentry
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"

# ------------------------------------------------------------------------------
# STORAGE (optional)
# ------------------------------------------------------------------------------
# For file uploads, exports, etc.
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
AWS_S3_BUCKET=""

# ------------------------------------------------------------------------------
# WEBHOOKS (optional)
# ------------------------------------------------------------------------------
# Clerk webhook secret for user sync
CLERK_WEBHOOK_SECRET=""

# Stripe webhook secret for billing
STRIPE_WEBHOOK_SECRET=""
